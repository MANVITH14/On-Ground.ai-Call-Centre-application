# ── On-Ground.ai Voice Server – Environment Variables ────────────────────────
#
# Copy to .env and fill in your real values.
# NEVER commit .env to Git.
#
# ── Required: Twilio credentials ─────────────────────────────────────────────
#
# 1. Account SID – found at https://console.twilio.com/ (starts with AC…)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. API Key SID – Console → Account → API keys → Create new API key (starts with SK…)
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. API Key Secret – shown ONCE when you create the API key (copy it immediately)
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# 4. TwiML App SID – Console → Voice → TwiML Apps → Create (starts with AP…)
#    Voice Request URL must be: https://<your-backend>/voice  (POST)
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. Caller ID – a verified Twilio phone number in E.164 format
#    Console → Phone Numbers → Manage → Active numbers
TWILIO_CALLER_ID=+12015551234

# ── Optional: Webhook security ────────────────────────────────────────────────
#
# Auth Token – required ONLY for Twilio signature validation
# Console → Account → API keys & tokens → Auth token (starts with a long string)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Set to "true" in production to validate every /voice webhook signature
VALIDATE_TWILIO_SIGNATURE=false

# Full public URL of the /voice endpoint (used for signature validation in prod)
# e.g. https://your-app.onrender.com/voice
PUBLIC_WEBHOOK_URL=https://your-backend.onrender.com/voice

# ── Server config ─────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
