# ── On-Ground.ai Call Centre – Environment Variables ────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git – it is already in .gitignore.
#
# ── Twilio Voice (Required for live calling) ─────────────────────────────────
#
# Your backend token endpoint URL (POST request → returns { token: "..." })
# See README.md → Twilio Setup for how to build the /token server.
#
VITE_TWILIO_TOKEN_ENDPOINT=

# ── Optional ─────────────────────────────────────────────────────────────────
# App title override
VITE_APP_NAME=On-Ground.ai Call Centre
