# ── On-Ground.ai Call Centre – Frontend Environment Variables ──────────────────
#
# Copy to .env and fill in your values.
# NEVER commit .env to Git – it is already in .gitignore.
#
# ── Twilio Voice backend URL ──────────────────────────────────────────────────
#
# Development: The Vite dev server proxies /api → http://localhost:3001
# so you can leave this pointing to /api/token.
#
# Production: Change to your deployed backend URL.
#
VITE_TOKEN_ENDPOINT=http://localhost:3001/token

# ── Optional ──────────────────────────────────────────────────────────────────
VITE_APP_NAME=On-Ground.ai Call Centre
